# =============================================================================
# RPG Workspace Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# SECURITY: .env is gitignored — never commit real API keys.
# If a key leaks, rotate it immediately at your provider's dashboard.
# rpg-mcp auto-discovers this file in: CARGO_MANIFEST_DIR/../.env,
# RPG_WORKSPACE/.env, or current_dir/.env.

# =============================================================================
# RPG-MCP SERVER CONFIGURATION
# =============================================================================

# Path to the workspace root to analyze (REQUIRED)
RPG_WORKSPACE=/path/to/your/project

# Directory for persisted graph data (optional, defaults to <workspace>/.rpg)
# This is where base.json, embeddings.bin, memories.jsonl, and dir_hash live.
# RPG_DATA_DIR=/path/to/output/data

# Hash mode for detecting file changes: "mtime" (default, fast) or "content" (accurate)
RPG_HASH_MODE=mtime

# Enable LLM semantic enrichment during initial encode (optional, default off)
# Set to "true" or "1" to enable. Requires OPENAI_* config below.
# When enabled, each function/type gets LLM-extracted behavioral features.
# These are persisted — subsequent launches reuse them with zero LLM cost.
RPG_SEMANTIC=false

# Explicit path to .env file (optional, overrides auto-discovery)
# RPG_ENV_FILE=/path/to/custom/.env

# Agent memory store location (optional, defaults to <workspace>/.rpg/memories.jsonl)
# Set to a path outside the repo for personal (non-committed) memories:
# RPG_MEMORY_FILE=~/.rpg/my-memories.jsonl

# Telemetry: JSONL log of every tool call (optional, disabled by default)
# Each line: {"ts":...,"tool":"search_nodes","param_keys":["query"],"duration_ms":3,"ok":true}
# RPG_TELEMETRY_FILE=/tmp/rpg-telemetry.jsonl

# Log level for tracing (optional, defaults to "info")
# Logs go to stderr — stdout is reserved for the MCP protocol.
# RUST_LOG=info
# RUST_LOG=rpg_mcp=debug

# =============================================================================
# LLM CONFIGURATION (required when RPG_SEMANTIC=true)
# =============================================================================
# Any OpenAI-compatible API works. Also reused by the embedding client.

# API key (required for LLM features and embedding auth)
OPENAI_API_KEY=your_api_key_here

# API base URL (optional, defaults to https://api.openai.com/v1)
# For Z.ai:   https://api.z.ai/api/coding/paas/v4
# For Azure:  https://your-resource.openai.azure.com
# For local:  http://localhost:8080/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name (optional, defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Max concurrent LLM requests (optional, defaults to 3)
# Also used by the embedding client (which defaults to 4 if unset)
OPENAI_MAX_CONCURRENT=3

# Enable reasoning/thinking mode (optional, default off)
OPENAI_REASONING=false

# Debug mode — logs full LLM request/response to stderr
RPG_DEBUG=false

# Debug output file (optional, writes LLM request/response JSON to file)
# RPG_DEBUG_FILE=/tmp/rpg-llm-debug.json

# =============================================================================
# EMBEDDING CONFIGURATION (optional, for vector_search)
# =============================================================================
# Required only if you want to use vector_search / encode_embeddings.
# The endpoint must be an OpenAI-compatible /embeddings API.

# RPGEN_EMBEDDING_ENDPOINT=http://localhost:8994/v1
# RPGEN_EMBEDDING_MODEL=Qwen3-Embedding-8B
# RPGEN_EMBEDDING_DIMENSION=4096
# RPGEN_EMBEDDING_BATCH_SIZE=64
